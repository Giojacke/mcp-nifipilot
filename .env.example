# NiFi connection
NIFI_URL=https://localhost:8443
NIFI_USERNAME=admin
NIFI_PASSWORD=changeme
NIFI_VERIFY_SSL=false          # true en producción con certificado válido

# NiFi single-user credentials (used by docker-compose for the nifi service)
# Min 12 chars required by NiFi single-user auth
SINGLE_USER_CREDENTIALS_USERNAME=admin
SINGLE_USER_CREDENTIALS_PASSWORD=changeme_min12chars

# MCP access level: readonly | full
MCP_MODE=readonly

# Audit log
MCP_AUDIT_LOG=true
MCP_AUDIT_LOG_PATH=./logs/audit.log

# Rate limiting (calls per minute)
MCP_RATE_LIMIT=60

# Dry run: describe actions without executing them
MCP_DRY_RUN=false

# Transport: stdio (default, for local clients) | sse (for Docker/remote)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
